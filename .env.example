# Required for Google Sign-In. Create a Web OAuth client in Google Cloud Console.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Comma-separated emails allowed to sign in as staff (staff cannot self-register)
STAFF_EMAILS=staff@example.com
# Generate a long random secret for sessions (32+ characters)
SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000
NODE_ENV=development
# Local-only demo buttons/sample data; set false in production
DEMO_MODE=true
APP_BASE_URL=http://localhost:3000
# Optional: Razorpay Test Mode credentials from Razorpay dashboard. Never use live keys for testing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: OpenAI API key enables LLM responses. Role-limited server context is still enforced.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: Gmail API OAuth2 credentials for real-time bill reminder emails.
# Enable Gmail API in Google Cloud, create OAuth credentials, grant gmail.send, and obtain a refresh token.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
